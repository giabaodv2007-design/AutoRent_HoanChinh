@model AutoRent.ViewModels.CheckoutVm
@{ ViewBag.Title="Đặt xe"; }
<div class="row justify-content-center py-4"><div class="col-lg-7"><div class="card p-4">
    <h2 class="fw-bold">Thông tin thanh toán / đặt xe</h2>
    <p class="text-muted">Đơn đặt xe sẽ ở trạng thái <strong>Chờ duyệt</strong>. Chưa thu tiền qua website.</p>
    @using(Html.BeginForm("Checkout","Cart",FormMethod.Post)) {
        @Html.AntiForgeryToken() @Html.ValidationSummary(false,"",new{@class="text-danger mb-3"})
        <div class="mb-3"><label class="form-label">Họ tên khách hàng</label>
            <input class="form-control" value="@Model.FullName" readonly /></div>
        <div class="mb-3"><label class="form-label">Số điện thoại *</label>
            @Html.TextBoxFor(x=>x.CustomerPhone,new{@class="form-control",required="required",maxlength="20",placeholder="09xxxxxxxx"})</div>
        <div class="mb-3"><label class="form-label">Ghi chú</label>
            @Html.TextAreaFor(x=>x.Note,new{@class="form-control",rows="3",maxlength="500"})</div>
        <button type="submit" class="btn btn-primary w-100 fw-bold">Xác nhận đặt xe</button>
    }
</div></div></div>
