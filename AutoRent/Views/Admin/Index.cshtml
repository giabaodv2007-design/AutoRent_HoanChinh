@{ ViewBag.Title="Bảng điều khiển Admin"; }
<h2 class="fw-bold mb-4">Tổng quan quản trị</h2>
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6"><div class="stat-card"><p>Danh mục</p><strong>@ViewBag.CategoryCount</strong></div></div>
    <div class="col-md-3 col-6"><div class="stat-card"><p>Mẫu xe</p><strong>@ViewBag.VehicleCount</strong></div></div>
    <div class="col-md-3 col-6"><div class="stat-card"><p>Tổng xe trong đội</p><strong>@ViewBag.StockCount</strong></div></div>
    <div class="col-md-3 col-6"><div class="stat-card"><p>Đơn đặt</p><strong>@ViewBag.OrderCount</strong></div></div>
</div>
