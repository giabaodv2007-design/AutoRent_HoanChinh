@model IEnumerable<AutoRent.Models.User>
@{ ViewBag.Title="Quản trị viên"; }
<h2 class="fw-bold">Tài khoản quản trị viên</h2>
<p class="text-muted">Trang này chỉ lưu tài khoản Admin; khách hàng xem riêng ở menu Khách hàng.</p>
<a href="@Url.Action("UserCreate")" class="btn btn-success mb-3">+ Tạo Admin</a>
<div class="card p-2 table-responsive"><table class="table"><thead><tr><th>ID</th><th>Họ tên</th><th>Email</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var u in Model) {
<tr><td>@u.UserId</td><td>@u.FullName</td><td>@u.Email</td><td>@(u.IsActive?"Hoạt động":"Đã khóa")</td><td>
<a class="btn btn-outline-primary btn-sm" href="@Url.Action("UserEdit",new{id=u.UserId})">Sửa</a>
@using(Html.BeginForm("UserDelete","Admin",new{id=u.UserId},FormMethod.Post,new{style="display:inline"})) {
    @Html.AntiForgeryToken()<button class="btn btn-outline-danger btn-sm" type="submit" onclick="return confirm('Xóa Admin này?')">Xóa</button>
}
</td></tr>
}</tbody></table></div>
