@model IEnumerable<AutoRent.ViewModels.VehicleListVm>
@{ ViewBag.Title="Quản lý xe"; }
<h2 class="fw-bold">Quản lý xe cho thuê</h2>
<a href="@Url.Action("VehicleCreate")" class="btn btn-success mb-3">+ Thêm xe mới</a>
<div class="card p-2 table-responsive"><table class="table mb-0 align-middle">
<thead><tr><th>Ảnh</th><th>Tên xe</th><th>Danh mục</th><th>Giá/ngày</th><th>Số lượng đội xe</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var v in Model) {
<tr><td><img src="@Url.Content(v.ImageUrl??"~/Content/images/placeholder.svg")" width="100" height="65" style="object-fit:contain" /></td>
<td class="fw-semibold">@v.Name<br/><small class="text-muted">@(v.IsAvailable?"Cho thuê":"Ngưng cho thuê")</small></td>
<td>@v.CategoryName</td><td>@v.DailyPrice.ToString("N0") ₫</td><td>@v.Quantity</td><td>
<a class="btn btn-sm btn-outline-info" href="@Url.Action("VehicleDetail",new{id=v.VehicleId})">Chi tiết</a>
<a class="btn btn-sm btn-outline-primary" href="@Url.Action("VehicleEdit",new{id=v.VehicleId})">Sửa</a>
@using(Html.BeginForm("VehicleDelete","Admin",new{id=v.VehicleId},FormMethod.Post,new{style="display:inline"})) {
    @Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('Xóa xe này?')">Xóa</button>
}
</td></tr>
}</tbody></table></div>
