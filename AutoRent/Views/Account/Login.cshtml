@model AutoRent.ViewModels.LoginVm
@{ ViewBag.Title = "Đăng nhập"; }
<div class="row justify-content-center py-5"><div class="col-md-6 col-lg-5">
    <div class="card p-4"><h2 class="fw-bold mb-3">Đăng nhập AutoRent</h2>
        @using (Html.BeginForm("Login", "Account", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post, null)) {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(false, "", new { @class="text-danger mb-3" })
            <div class="mb-3"><label class="form-label">Email</label>@Html.TextBoxFor(x=>x.Email, new {@class="form-control", type="email", required="required"})</div>
            <div class="mb-3"><label class="form-label">Mật khẩu</label>@Html.PasswordFor(x=>x.Password, new {@class="form-control", required="required"})</div>
            <button class="btn btn-primary w-100" type="submit">Đăng nhập</button>
        }
        <p class="text-muted mt-3 mb-0">Chưa có tài khoản? <a href="@Url.Action("Register")">Đăng ký</a></p>
    </div>
</div></div>
