<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewBag.Title ?? "AutoRent") - AutoRent</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/site.css")" rel="stylesheet" />
</head>
<body>
    @Html.Action("Header", "Site")
    <main class="container content-area">
        @if (TempData["Success"] != null) { <div class="alert alert-success mt-3">@TempData["Success"]</div> }
        @if (TempData["Error"] != null) { <div class="alert alert-danger mt-3">@TempData["Error"]</div> }
        @RenderBody()
    </main>
    <footer class="border-top py-4 mt-5 bg-white"><div class="container d-flex flex-wrap justify-content-between text-muted small">
        <span>© AutoRent — </span>
        <span>Giá thuê và tiền cọc là giả</span>
    </div></footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
