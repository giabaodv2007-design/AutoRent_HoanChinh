@model AutoRent.ViewModels.VehicleDetailVm
<div class="row g-4 mb-4">
    <div class="col-lg-7"><img class="vehicle-detail-img" src="@Url.Content(Model.Vehicle.ImageUrl??"~/Content/images/placeholder.svg")" alt="@Model.Vehicle.Name" /></div>
    <div class="col-lg-5">
        <span class="info-chip mb-2">@Model.CategoryName</span>
        <h2 class="fw-bold">@Model.Vehicle.Name</h2>
        <p class="text-muted">Thương hiệu: @Model.Vehicle.Brand</p>
        <p>@Model.Vehicle.Description</p>
        <div class="card p-3 mb-3">
            <div class="d-flex justify-content-between"><span>Giá thuê mỗi ngày</span><strong class="price">@Model.Vehicle.DailyPrice.ToString("N0") ₫</strong></div><hr/>
            <div class="d-flex justify-content-between"><span>Tiền cọc / xe</span><strong>@Model.Vehicle.Deposit.ToString("N0") ₫</strong></div><hr/>
            <div class="d-flex justify-content-between"><span>Số xe trong đội</span><strong>@Model.Vehicle.Quantity xe</strong></div>
        </div>
        @if(Model.AdminView) { <div class="alert alert-secondary">Đang ở trang Admin: chỉ xem thông tin, không có nút thuê.</div> }
        else if(Model.Vehicle.IsAvailable && Model.Vehicle.Quantity>0) {
            using(Html.BeginForm("Add","Cart",FormMethod.Post,new{@class="card p-3"})) {
                @Html.AntiForgeryToken()
                <input type="hidden" name="VehicleId" value="@Model.Vehicle.VehicleId" />
                <h5 class="fw-bold">Chọn thời gian và số xe</h5>
                <div class="row g-2 mb-3"><div class="col-6"><label class="form-label">Từ ngày</label>
                    <input class="form-control" type="date" name="StartDate" required min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@DateTime.Today.ToString("yyyy-MM-dd")" /></div>
                    <div class="col-6"><label class="form-label">Đến ngày</label>
                    <input class="form-control" type="date" name="EndDate" required min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@DateTime.Today.ToString("yyyy-MM-dd")" /></div>
                    <div class="col-6"><label class="form-label">Số lượng</label><input class="form-control" type="number" name="Quantity" min="1" max="@Math.Min(Model.Vehicle.Quantity,100)" value="1" required /></div>
                </div>
                <p class="text-muted small">Giá tính theo ngày (tính cả ngày đầu và cuối), tối đa 30 ngày. Hệ thống kiểm tra số xe trống theo lịch thuê.</p>
                <button class="btn btn-warning fw-bold" type="submit">🛒 Thêm vào giỏ hàng</button>
            }
        } else { <div class="alert alert-warning">Xe hiện không cho thuê hoặc số lượng bằng 0.</div> }
    </div>
</div>
