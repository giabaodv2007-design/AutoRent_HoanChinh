@model AutoRent.ViewModels.OrderDetailVm
<div class="card invoice p-4 mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap">
        <div><h2 class="fw-bold">AutoRent · HÓA ĐƠN THUÊ XE</h2><p class="text-muted">Mã đơn #@Model.Order.OrderId · @Model.Order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p></div>
        <span class="badge bg-info text-dark fs-6">@Model.Order.Status</span>
    </div><hr />
    <p class="mb-1"><b>Khách hàng:</b> @Model.Order.CustomerName</p>
    <p class="mb-1"><b>Điện thoại:</b> @Model.CustomerPhone</p>
    <p class="mb-3"><b>Ghi chú:</b> @(string.IsNullOrWhiteSpace(Model.Note)?"(Không có)":Model.Note)</p>
    <div class="table-responsive"><table class="table table-bordered align-middle">
        <thead><tr><th>Xe</th><th>Từ ngày</th><th>Đến ngày</th><th>Ngày</th><th>Số xe</th><th>Đơn giá/ngày</th><th>Thành tiền</th><th>Cọc</th></tr></thead>
        <tbody>@foreach(var x in Model.Items) {
            <tr><td>@x.VehicleName</td><td>@x.StartDate.ToString("dd/MM/yyyy")</td><td>@x.EndDate.ToString("dd/MM/yyyy")</td>
                <td>@x.Days</td><td>@x.Quantity</td><td>@x.PricePerDay.ToString("N0") ₫</td>
                <td>@x.RentAmount.ToString("N0") ₫</td><td>@x.Deposit.ToString("N0") ₫</td></tr>
        }</tbody>
    </table></div>
    <div class="text-end"><p>Tổng tiền thuê: <strong>@Model.Order.TotalRent.ToString("N0") ₫</strong></p>
        <p>Tiền cọc (riêng): <strong>@Model.Order.TotalDeposit.ToString("N0") ₫</strong></p>
        <p class="h5">Dự kiến cần chuẩn bị: <strong>@((Model.Order.TotalRent+Model.Order.TotalDeposit).ToString("N0")) ₫</strong></p>
    </div><p class="text-muted small mb-0">Đây là xác nhận đặt xe minh họa, không phải chứng từ thanh toán điện tử.</p>
</div>
